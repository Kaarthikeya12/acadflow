{
  "name": "acadflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:reset": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reset.ts",
    "db:test:setup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/test-setup.ts",
    "test": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test tests/actions/*.test.ts",
    "test:db": "npm run db:test:setup && node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test tests/db/*.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
