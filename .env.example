# --- Copy to .env.local and fill in real values. Never commit secrets. ---

# Runtime database role (least privilege). Required.
DATABASE_URL=
# Schema-owner role. Used only by `npm run db:migrate`. Defaults to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=
# Separate database used by `npm run test:db`.
TEST_DATABASE_URL=

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical origin used for redirects.
APP_BASE_URL=http://localhost:3000
# IANA timezone. Required; deadline handling fails closed when unset.
APP_TIMEZONE=Asia/Kolkata
# Absolute or project-relative path OUTSIDE public/.
FILE_STORAGE_PATH=.storage

# Optional
AUTH_TRUST_HOST=true
